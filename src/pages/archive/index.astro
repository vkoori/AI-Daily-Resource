---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { groupByDay, formatPersianDate } from '../../utils/content';

const byDay = await groupByDay();
const days = [...byDay.keys()].sort().reverse();
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="آرشیو · دیجست روزانه هوش مصنوعی">
  <section class="container head">
    <h1>آرشیو روزانه</h1>
    <p class="muted">همه گزارش‌های روزانه، از جدیدترین به قدیمی‌ترین.</p>
  </section>

  <section class="container">
    {days.length === 0 ? (
      <p class="muted">هنوز گزارشی ثبت نشده است.</p>
    ) : (
      <ul class="day-list">
        {days.map((day) => {
          const items = byDay.get(day)!;
          return (
            <li>
              <a href={`${base}archive/${day}/`} class="day-row">
                <time class="ltr" datetime={day}>{formatPersianDate(new Date(day))}</time>
                <span class="count">{items.length} مطلب</span>
              </a>
            </li>
          );
        })}
      </ul>
    )}
  </section>
</BaseLayout>

<style>
  .head { padding-block: var(--sp-7) var(--sp-5); }
  .muted { color: var(--text-muted); }
  .day-list { list-style: none; margin: 0 0 var(--sp-7); padding: 0; display: flex; flex-direction: column; gap: var(--sp-2); }
  .day-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--sp-4) var(--sp-5);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--text);
  }
  .day-row:hover { border-color: var(--border-strong); text-decoration: none; }
  .count { font-size: var(--fs-xs); color: var(--text-faint); }
</style>
