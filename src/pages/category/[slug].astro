---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getAllItemsSorted, categoryLabel, categoryList } from '../../utils/content';

export async function getStaticPaths() {
  const items = await getAllItemsSorted();
  return categoryList.map((c) => ({
    params: { slug: c.slug },
    props: { items: items.filter((i) => i.data.category === c.slug) },
  }));
}

const { slug } = Astro.params;
const { items } = Astro.props;
const label = categoryLabel(slug!);
const base = import.meta.env.BASE_URL;
---
<BaseLayout title={`${label.fa} · دیجست روزانه هوش مصنوعی`}>
  <section class="container head">
    <a class="back" href={`${base}`}>← صفحه اصلی</a>
    <h1>{label.fa}</h1>
    <p class="en ltr">{label.en}</p>
    <p class="muted">{items.length} مطلب</p>
  </section>

  <section class="container">
    {items.length === 0 ? (
      <p class="muted">هنوز مطلبی در این دسته ثبت نشده است.</p>
    ) : (
      <div class="grid">
        {items.map((item) => <ArticleCard item={item} />)}
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .head { padding-block: var(--sp-7) var(--sp-5); }
  .back { font-size: var(--fs-sm); color: var(--text-muted); }
  .en { color: var(--text-faint); font-size: var(--fs-sm); margin: 0 0 var(--sp-2); }
  .muted { color: var(--text-faint); font-size: var(--fs-sm); }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--sp-5);
    padding-bottom: var(--sp-7);
  }
</style>
